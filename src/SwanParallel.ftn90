!> Partition unstructured meshes and exchange halo and boundary data.
module SwanParallel
!
!   --|-----------------------------------------------------------|--
!     | Delft University of Technology                            |
!     | Faculty of Civil Engineering and Geosciences              |
!     | Environmental Fluid Mechanics Section                     |
!     | P.O. Box 5048, 2600 GA  Delft, The Netherlands            |
!     |                                                           |
!     | Programmer: Marcel Zijlema                                |
!   --|-----------------------------------------------------------|--
!
!
!     SWAN (Simulating WAves Nearshore); a third generation wave model
!     Copyright (C) 1993-2024  Delft University of Technology
!
!     This program is free software: you can redistribute it and/or modify
!     it under the terms of the GNU General Public License as published by
!     the Free Software Foundation, either version 3 of the License, or
!     (at your option) any later version.
!
!     This program is distributed in the hope that it will be useful,
!     but WITHOUT ANY WARRANTY; without even the implied warranty of
!     MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
!     GNU General Public License for more details.
!
!     You should have received a copy of the GNU General Public License
!     along with this program. If not, see <http://www.gnu.org/licenses/>.
!
!
!   Authors
!
!   42.10: Marcel Zijlema
!
!   Updates
!
!   42.10, June 2023: New subroutine
!
!   Purpose
!
!   Module containing data for parallel computing using Metis and MPI
!
!   Method
!
!   Data with respect to grid partition properties based on Metis
!
!   Modules used
!
!   none
!
   use, intrinsic :: iso_c_binding, only: c_float, c_int, c_int32_t
   implicit none
   private

   public :: SwanParallelComm, SwanDecomposition, SwanCommAdmin
   public :: SwanUvExchgI, SwanUvExchgR, SwanCollBpntlist
   public :: ipown, vres, nvcomm, vsubcm, ivrecv, ivsend, nvrecv, nvsend
   public :: irbuf, isbuf, rrqst, srqst, rbuf, sbuf

   ! The METIS package uses 32-bit indices and weights. SWAN fields follow
   ! the solver's selected default real kind, independently of METIS.
   integer, parameter :: METIS_INDEX_KIND = c_int32_t
   integer, parameter :: METIS_REAL_KIND = c_float
   integer, parameter :: SWAN_REAL_KIND = kind(0.0)
   integer, parameter :: HALO_TAG = 2

   ! Legacy SWAN diagnostics use external procedures.
   interface
      subroutine msgerr(level, message)
         integer, intent(in) :: level !< SWAN severity level.
         character(len=*), intent(in) :: message !< Diagnostic to record.
      end subroutine msgerr

      subroutine strace(entries, routine_name)
         integer, intent(inout) :: entries !< Counter of procedure entries.
         character(len=*), intent(in) :: routine_name !< Procedure name.
      end subroutine strace

      function stpnow() result(stopping)
         logical :: stopping !< Whether the current run must stop.
      end function stpnow
   end interface
   !
   ! relevant constants taken from metis.h
   !
   integer(kind=METIS_INDEX_KIND), parameter :: METIS_NOPTIONS = 40 ! number of options used in Metis
   !
   integer(kind=METIS_INDEX_KIND), parameter :: METIS_OK = 1 ! returned normally
   integer(kind=METIS_INDEX_KIND), parameter :: METIS_ERROR_INPUT = -2 ! returned due to erroneous inputs and/or options
   integer(kind=METIS_INDEX_KIND), parameter :: METIS_ERROR_MEMORY = -3 ! returned due to insufficient memory
   integer(kind=METIS_INDEX_KIND), parameter :: METIS_ERROR = -4 ! some other errors
   !
   ! data structures to be used for Metis
   !
   integer(kind=METIS_INDEX_KIND), dimension(:), save, allocatable :: ipown ! Owner of each vertex.
   !
   ! data structures belonging to own sudomain
   !
   logical, dimension(:), save, allocatable :: vres ! vertex-based identification list
   ! = .true. ; resident vertex
   ! = .false.; ghost vertex
   !
   ! Data structures for MPI communication.
   integer :: nvcomm ! number of subdomains communicating with current subdomain
   !
   integer, dimension(:), save, allocatable :: vsubcm ! vertex-based list of communicating subdomains
   !
   integer, dimension(:, :), save, allocatable :: ivrecv ! vertex-based receive list
   ! = (i,j);  local index of i-th ghost vertex to receive from neighbour
   ! subdomain j
   integer, dimension(:, :), save, allocatable :: ivsend ! vertex-based send list
   ! = (i,j);  local index of i-th ghost vertex to send to neighbour subdomain j
   integer, dimension(:), save, allocatable :: nvrecv ! number of ghost vertices to receive in each communicating subdomain
   integer, dimension(:), save, allocatable :: nvsend ! number of ghost vertices to send in each communicating subdomain
   !
   integer, dimension(:, :), save, allocatable :: irbuf ! buffer to store integers to receive temporarily
   integer, dimension(:, :), save, allocatable :: isbuf ! buffer to store integers to send temporarily
   integer, dimension(:), save, allocatable :: rrqst ! request handles for the MPI_IRECV command
   integer, dimension(:), save, allocatable :: srqst ! request handles for the MPI_ISEND command
   !
   real(kind=SWAN_REAL_KIND), dimension(:, :), save, allocatable :: rbuf ! buffer to store reals to receive temporarily
   real(kind=SWAN_REAL_KIND), dimension(:, :), save, allocatable :: sbuf ! buffer to store reals to send temporarily
!
!   Source text
!
contains
!
   !> Return the communicator supplied to SWAN_LIB by its MPI caller.
   function SwanParallelComm() result(communicator)
      use m_parall, only: comm

      integer :: communicator !< MPI communicator used by SWAN.

      communicator = comm
   end function SwanParallelComm
!
   !> Partition the global mesh and prepare halo communication.
   subroutine SwanDecomposition(logcom)
!
!   --|-----------------------------------------------------------|--
!     | Delft University of Technology                            |
!     | Faculty of Civil Engineering and Geosciences              |
!     | Environmental Fluid Mechanics Section                     |
!     | P.O. Box 5048, 2600 GA  Delft, The Netherlands            |
!     |                                                           |
!     | Programmer: Marcel Zijlema                                |
!   --|-----------------------------------------------------------|--
!
!
!     SWAN (Simulating WAves Nearshore); a third generation wave model
!     Copyright (C) 1993-2024  Delft University of Technology
!
!     This program is free software: you can redistribute it and/or modify
!     it under the terms of the GNU General Public License as published by
!     the Free Software Foundation, either version 3 of the License, or
!     (at your option) any later version.
!
!     This program is distributed in the hope that it will be useful,
!     but WITHOUT ANY WARRANTY; without even the implied warranty of
!     MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
!     GNU General Public License for more details.
!
!     You should have received a copy of the GNU General Public License
!     along with this program. If not, see <http://www.gnu.org/licenses/>.
!
!
!   Authors
!
!   42.10: Marcel Zijlema
!
!   Updates
!
!   42.10, June 2023: New subroutine
!
!   Purpose
!
!   Carries out domain decomposition meant for distributed-memory approach
!
!   Method
!
!   Carry out the partitioning of the unstructured mesh first and then do the
!   administration for MPI communication
!
!   Modules used
!
      use ocpcomm4, only: ltrace
      use m_parall, only: parll
      use SwanGriddata, only: ncells, ncellsg, nverts, nvertsg
!
!   Argument variables
!
      logical, dimension(7), intent(inout) :: logcom !< Completed setup steps.
      ! Flags used by SWAN's command parser:
      ! (1) no meaning
      ! (2) command CGRID has been carried out
      ! (3) command READINP BOTTOM has been carried out
      ! (4) command READ COOR has been carried out
      ! (5) command READ UNSTRUC has been carried out
      ! (6) arrays s1, u1 and v1 have been allocated
      ! (7) mesh partitioning has been carried out
!
!   Local variables
!
      integer, save :: ient = 0 ! number of entries in this subroutine
!
!   Structure
!
!   Description of the pseudo code
!
!   Source text
!
      if (ltrace) then
         call strace(ient, 'SwanDecomposition')
      end if
      !
      if (.not. PARLL) then
         return
      end if
      !
      ! store sizes of the global computational mesh
      !
      nvertsg = nverts
      ncellsg = ncells
      !
      ! carry out the mesh partitioning
      !
      if (allocated(ipown)) then
         deallocate(ipown)
      end if
      allocate (ipown(nvertsg))
      ipown = 0
      call SwanMeshPartition
      if (STPNOW()) then
         return
      end if
      !
      ! carry out the administration
      !
      call SwanCommAdmin
      if (STPNOW()) then
         return
      end if
      !
      logcom(7) = .true.
      !
   end subroutine SwanDecomposition
!
   !> Build the vertex graph and partition it with METIS.
   subroutine SwanMeshPartition
!
!   --|-----------------------------------------------------------|--
!     | Delft University of Technology                            |
!     | Faculty of Civil Engineering and Geosciences              |
!     | Environmental Fluid Mechanics Section                     |
!     | P.O. Box 5048, 2600 GA  Delft, The Netherlands            |
!     |                                                           |
!     | Programmer: Marcel Zijlema                                |
!   --|-----------------------------------------------------------|--
!
!
!     SWAN (Simulating WAves Nearshore); a third generation wave model
!     Copyright (C) 1993-2024  Delft University of Technology
!
!     This program is free software: you can redistribute it and/or modify
!     it under the terms of the GNU General Public License as published by
!     the Free Software Foundation, either version 3 of the License, or
!     (at your option) any later version.
!
!     This program is distributed in the hope that it will be useful,
!     but WITHOUT ANY WARRANTY; without even the implied warranty of
!     MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
!     GNU General Public License for more details.
!
!     You should have received a copy of the GNU General Public License
!     along with this program. If not, see <http://www.gnu.org/licenses/>.
!
!
!   Authors
!
!   42.10: Marcel Zijlema
!
!   Updates
!
!   42.10, June 2023: New subroutine
!
!   Purpose
!
!   Carries out the partitioning of the unstructured triangular mesh
!
!   Method
!
!   the Metis graph partitioning library is used to partition the given mesh
!   among the subdomains
!   using multilevel k-way partitioning and places the subdomain numbers into
!   the ipown array
!
!   Note: to compute adjacency lists efficient, the algorithm of metis.F taken
!   from the ADCIRC suite is employed
!
!   Modules used
!
      use ocpcomm4, only: itest, ltrace, printf, prtest
      use m_parall, only: iammaster, nproc
      use SwanGriddata, only: kvertc, ncellsg, nvertsg
!
!   Parameter variables
!
      integer, parameter :: VERTICES_PER_CELL = 3 ! number of vertices in cell (triangles only)
      integer(kind=METIS_INDEX_KIND), parameter :: CONSTRAINT_COUNT = 1 ! METIS balancing constraints.
      real(kind=METIS_REAL_KIND), dimension(CONSTRAINT_COUNT), parameter :: IMBALANCE_TOLERANCE = &
         1.001_METIS_REAL_KIND
!
!   Local variables
!
      integer :: i ! loop counter
      integer, save :: ient = 0 ! number of entries in this subroutine
      integer(kind=c_int) :: ierr ! METIS status.
      integer :: io_status, close_status
      integer :: istat ! indicate status of allocation
      integer(kind=METIS_INDEX_KIND) :: ivert ! vertex index
      integer :: j ! loop counter
      integer(kind=METIS_INDEX_KIND) :: jvert ! index of neighbouring vertex
      integer(kind=METIS_INDEX_KIND) :: k ! counter
      integer(kind=METIS_INDEX_KIND) :: maxfv ! maximum number of faces for any vertex
      integer :: ndsd ! unit reference number of file
      integer(kind=METIS_INDEX_KIND) :: ne ! number of edges in the graph
      integer(kind=METIS_INDEX_KIND) :: nf2 ! twice the number of faces
      integer(kind=METIS_INDEX_KIND) :: np ! number of partitions
      integer(kind=METIS_INDEX_KIND) :: nv ! number of vertices in the graph
      integer(kind=METIS_INDEX_KIND) :: edgecut ! total edges cut of the partitioning
      !
      integer(kind=METIS_INDEX_KIND), dimension(METIS_NOPTIONS) :: options ! METIS option values.
      !
      integer(kind=METIS_INDEX_KIND), dimension(:), allocatable :: adjncy ! Compressed adjacency list.
      integer(kind=METIS_INDEX_KIND), dimension(:), allocatable :: adjw ! Edge weights.
      integer(kind=METIS_INDEX_KIND), dimension(:, :), allocatable :: covts ! Neighbors of each vertex.
      ! = (j,i); index of j-th neighbouring vertex linked to vertex i
      integer(kind=METIS_INDEX_KIND), dimension(:), allocatable :: nfacev ! number of faces for each vertex
      integer(kind=METIS_INDEX_KIND), dimension(:), allocatable :: vneigh ! sorted neighbouring vertices
      integer(kind=METIS_INDEX_KIND), dimension(:), allocatable :: vsize ! Vertex sizes (unused for edge-cut minimization).
      integer(kind=METIS_INDEX_KIND), dimension(:), allocatable :: vwgt ! Vertex weights.
      integer(kind=METIS_INDEX_KIND), dimension(:), allocatable :: xadj ! Offsets into the compressed adjacency list.
      !
      real(kind=METIS_REAL_KIND), dimension(:), allocatable :: tpwgts ! Target partition weights.
      !
      character(len=120) :: msgstr ! string to pass message
      !
      logical :: found ! true if desired vertex for symmetry check is found
      logical :: symmetric ! true if adjacency vertex matrix is symmetric
      !
      ! Bind the C symbols used by the METIS Fortran wrappers directly.
      interface
         function metis_set_default_options(options) bind(C, name="METIS_SetDefaultOptions") result(status)
            import :: c_int, METIS_INDEX_KIND, METIS_NOPTIONS
            integer(kind=METIS_INDEX_KIND), dimension(METIS_NOPTIONS), intent(out) :: options !< Option values.

            integer(kind=c_int) :: status !< METIS status code.
         end function metis_set_default_options

         function metis_part_graph_kway(nvtxs, ncon, xadj, adjncy, vwgt, vsize, adjwgt, nparts, &
                                       tpwgts, ubvec, options, edgecut, part) &
                                       bind(C, name="METIS_PartGraphKway") result(status)
            import :: c_int, METIS_INDEX_KIND, METIS_REAL_KIND, METIS_NOPTIONS
            integer(kind=METIS_INDEX_KIND), intent(in) :: nvtxs !< Number of graph vertices.
            integer(kind=METIS_INDEX_KIND), intent(in) :: ncon !< Number of balancing constraints.
            integer(kind=METIS_INDEX_KIND), dimension(nvtxs + 1), intent(inout) :: xadj !< CSR offsets.
            integer(kind=METIS_INDEX_KIND), dimension(*), intent(inout) :: adjncy !< CSR neighbors.
            integer(kind=METIS_INDEX_KIND), dimension(nvtxs * ncon), intent(in) :: vwgt !< Vertex weights.
            integer(kind=METIS_INDEX_KIND), dimension(nvtxs), intent(in) :: vsize !< Vertex sizes.
            integer(kind=METIS_INDEX_KIND), dimension(*), intent(in) :: adjwgt !< CSR edge weights.
            integer(kind=METIS_INDEX_KIND), intent(in) :: nparts !< Number of partitions.
            real(kind=METIS_REAL_KIND), dimension(ncon * nparts), intent(in) :: tpwgts !< Target weights.
            real(kind=METIS_REAL_KIND), dimension(ncon), intent(in) :: ubvec !< Imbalance tolerance.
            integer(kind=METIS_INDEX_KIND), dimension(METIS_NOPTIONS), intent(in) :: options !< Options.
            integer(kind=METIS_INDEX_KIND), intent(out) :: edgecut !< Edge-cut weight.
            integer(kind=METIS_INDEX_KIND), dimension(nvtxs), intent(out) :: part !< Vertex owners.

            integer(kind=c_int) :: status !< METIS status code.
         end function metis_part_graph_kway
      end interface
!
!   Structure
!
!   Description of the pseudo code
!
!   Source text
!
      if (ltrace) then
         call strace(ient, 'SwanMeshPartition')
      end if
      !
      ! set size of input graph based on vertices of the global mesh
      !
      nv = int(nvertsg, kind=METIS_INDEX_KIND)
      !
      ! set number of partitions equal to the number of parallel cores
      !
      np = int(nproc, kind=METIS_INDEX_KIND)
      !
      if (ITEST >= 50 .and. IAMMASTER) then
         write (PRINTF, '(a)')
         write (PRINTF, 201) nv, np
      end if
      !
      ! allocate data for mesh partitioning
      !
      istat = 0
      if (.not. allocated(xadj)) then
         allocate (xadj(1 + nv), stat=istat)
      end if
      if (istat == 0 .and. .not. allocated(vwgt)) then
         allocate (vwgt(nv), stat=istat)
      end if
      if (istat == 0 .and. .not. allocated(vsize)) then
         allocate (vsize(nv), stat=istat)
      end if
      if (istat == 0 .and. .not. allocated(tpwgts)) then
         allocate (tpwgts(np), stat=istat)
      end if
      if (istat == 0 .and. .not. allocated(nfacev)) then
         allocate (nfacev(nv), stat=istat)
      end if
      if (istat /= 0) then
         write (msgstr, '(a,i0)') 'Cannot allocate mesh partitioning data, status ', istat
         call msgerr(4, trim(msgstr))
         return
      end if

      ne = 0
      nfacev = 0
      !
      ! compute the number of faces for each vertex
      !
      do j = 1, VERTICES_PER_CELL
         do i = 1, ncellsg
            ivert = kvertc(j, i)
            ne = ne + 2
            k = nfacev(ivert) + 2
            nfacev(ivert) = k
         end do
      end do
      !
      ! compute the maximum number of faces for any vertex
      !
      maxfv = 0
      do i = 1, nvertsg
         if (nfacev(i) > maxfv) then
            maxfv = nfacev(i)
         end if
      end do
      !
      ! allocate remaining data for mesh partitioning
      !
      if (istat == 0 .and. .not. allocated(adjncy)) then
         allocate (adjncy(ne), stat=istat)
      end if
      if (istat == 0 .and. .not. allocated(adjw)) then
         allocate (adjw(ne), stat=istat)
      end if
      if (istat == 0) then
         allocate (covts(maxfv, nv), vneigh(maxfv), stat=istat)
      end if
      !
      if (istat /= 0) then
         write (msgstr, '(a,i6)') 'allocation problem: mesh partitioning data and return code is ', istat
         call msgerr(4, trim(msgstr))
         return
      end if
      !
      ! compute list of neighbouring vertices and number of faces containing a
      ! vertex
      !
      nfacev = 0
      !
      do j = 1, VERTICES_PER_CELL
         do i = 1, ncellsg
            ivert = kvertc(j, i)
            covts(nfacev(ivert) + 1, ivert) = kvertc(mod(j, 3) + 1, i)
            covts(nfacev(ivert) + 2, ivert) = kvertc(mod(j + 1, 3) + 1, i)
            k = nfacev(ivert) + 2
            nfacev(ivert) = k
         end do
      end do
      !
      ! remove multiple entries from the adjacency vertex list
      !
      nf2 = 0
      do i = 1, nvertsg
         do j = 1, nfacev(i)
            vneigh(j) = covts(j, i)
         end do
         if (nfacev(i) > 1) then
            k = nfacev(i)
            call hpsort(vneigh(:k))
            jvert = vneigh(1)
            covts(1, i) = jvert
            k = 1
            do j = 2, nfacev(i)
               if (vneigh(j) /= jvert) then
                  k = k + 1
                  jvert = vneigh(j)
                  covts(k, i) = jvert
               end if
            end do
         else
            write (msgstr, '(a,i7)') 'vertex ', i, ' is isolated'
            call msgerr(4, trim(msgstr))
            return
         end if
         nfacev(i) = k
         nf2 = nf2 + k
      end do
      if (ITEST >= 50 .and. IAMMASTER) then
         write (PRTEST, 202) nf2 / 2
      end if
      !
      ! check that adjacency matrix is symmetric
      !
      symmetric = .true.
      !
      do i = 1, nvertsg
         do j = 1, nfacev(i)
            jvert = covts(j, i)
            found = .false.
            do k = 1, nfacev(jvert)
               if (covts(k, jvert) == i) then
                  found = .true.
                  exit
               end if
            end do
            if (.not. found) then
               symmetric = .false.
               write (msgstr, '(a,i7,a,i7,a)') 'vertex ', i, ' adjacent to ', jvert, ' but not vice versa'
               call msgerr(1, trim(msgstr))
            end if
         end do
      end do
      !
      if (.not. symmetric) then
         call msgerr(4, 'inconsistency found in SwanMeshPartition: adjacency matrix is not symmetric')
         return
      end if
      !
      ! compute weights of the graph vertices
      !
      vwgt = nfacev
      !
      ! compute adjacency list of graph and its face weights
      !
      xadj(1) = 1
      !
      k = 0
      !
      do ivert = 1, nvertsg
         do j = 1, nfacev(ivert)
            jvert = covts(j, ivert)
            k = k + 1
            adjncy(k) = jvert
            adjw(k) = vwgt(ivert) + vwgt(jvert)
         end do
         xadj(ivert + 1) = k + 1
      end do
      !
      ! by default, the Metis numbering starts from zero
      !
      xadj = xadj - 1
      adjncy = adjncy - 1
      !
      ! vsize not used, set to NULL
      !
      vsize = 0
      !
      ! the graph will be equally distributed among the processors
      !
      tpwgts = 1.0_METIS_REAL_KIND / real(np, kind=METIS_REAL_KIND)
      !
      ! set the Metis defaults, in particular edge-cut minimization and C-style
      ! numbering
      !
      ierr = metis_set_default_options(options)
      if (ierr /= METIS_OK) then
         if (ierr == METIS_ERROR_INPUT) then
            write (msgstr, '(a)') 'function METIS_SetDefaultOptions failed due to erroneous inputs or options'
         else if (ierr == METIS_ERROR_MEMORY) then
            write (msgstr, '(a)') 'function METIS_SetDefaultOptions failed due to insufficient memory'
         else if (ierr == METIS_ERROR) then
            write (msgstr, '(a)') 'function METIS_SetDefaultOptions failed with another Metis error'
         else
            write (msgstr, '(a,i2)') 'function METIS_SetDefaultOptions failed with unknown error: ', ierr
         end if
         call msgerr(4, trim(msgstr))
         return
      end if
      !
      ! partition the graph and create the ipown array
      !
      ierr = metis_part_graph_kway(nv, CONSTRAINT_COUNT, xadj, adjncy, vwgt, vsize, adjw, np, &
                                  tpwgts, IMBALANCE_TOLERANCE, options, edgecut, ipown)
      !
      if (ierr /= METIS_OK) then
         if (ierr == METIS_ERROR_INPUT) then
            write (msgstr, '(a)') 'function METIS_PartGraphKway failed due to erroneous inputs or options'
         else if (ierr == METIS_ERROR_MEMORY) then
            write (msgstr, '(a)') 'function METIS_PartGraphKway failed due to insufficient memory'
         else if (ierr == METIS_ERROR) then
            write (msgstr, '(a)') 'function METIS_PartGraphKway failed with another Metis error'
         else
            write (msgstr, '(a,i2)') 'function METIS_PartGraphKway failed with unknown error: ', ierr
         end if
         call msgerr(4, trim(msgstr))
         return
      end if
      !
      ! use Fortran-style numbering
      !
      ipown = ipown + 1
      !
      ! deallocate auxiliary arrays
      !
      deallocate (xadj, adjncy, vwgt, vsize, adjw, tpwgts, nfacev, covts, vneigh)
      !
      if (ITEST >= 50 .and. IAMMASTER) then
         write (PRTEST, 203) edgecut
         write (PRINTF, '(a)') ' writing mesh partition to file partit.mesh'
         open (newunit=ndsd, file='partit.mesh', status='replace', action='write', &
               iostat=io_status, iomsg=msgstr)
         if (io_status /= 0) then
            call msgerr(1, 'Cannot open partit.mesh: ' // trim(msgstr))
            return
         end if
         do i = 1, nvertsg
            write (ndsd, '(i6)', iostat=io_status, iomsg=msgstr) ipown(i)
            if (io_status /= 0) then
               call msgerr(1, 'Cannot write partit.mesh: ' // trim(msgstr))
               exit
            end if
         end do
         close (ndsd, iostat=close_status, iomsg=msgstr)
         if (close_status /= 0) then
            call msgerr(1, 'Cannot close partit.mesh: ' // trim(msgstr))
         end if
      end if
      !
201   format(' unstructured mesh containing ', i7, ' vertices is partitioned into ', i4, ' subdomains')
202   format(' total number of faces found during mesh partitioning = ', i7)
203   format(' total edges cut = ', i8)
      !
   end subroutine SwanMeshPartition
!
   !> Build local mesh maps and halo exchange lists.
   subroutine SwanCommAdmin
!
!   --|-----------------------------------------------------------|--
!     | Delft University of Technology                            |
!     | Faculty of Civil Engineering and Geosciences              |
!     | Environmental Fluid Mechanics Section                     |
!     | P.O. Box 5048, 2600 GA  Delft, The Netherlands            |
!     |                                                           |
!     | Programmer: Marcel Zijlema                                |
!   --|-----------------------------------------------------------|--
!
!
!     SWAN (Simulating WAves Nearshore); a third generation wave model
!     Copyright (C) 1993-2024  Delft University of Technology
!
!     This program is free software: you can redistribute it and/or modify
!     it under the terms of the GNU General Public License as published by
!     the Free Software Foundation, either version 3 of the License, or
!     (at your option) any later version.
!
!     This program is distributed in the hope that it will be useful,
!     but WITHOUT ANY WARRANTY; without even the implied warranty of
!     MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
!     GNU General Public License for more details.
!
!     You should have received a copy of the GNU General Public License
!     along with this program. If not, see <http://www.gnu.org/licenses/>.
!
!
!   Authors
!
!   42.10: Marcel Zijlema
!
!   Updates
!
!   42.10, June 2023: New subroutine
!
!   Purpose
!
!   Carries out the administration for message passing
!
!   Method
!
!   - subdomains need to be augmented with a layer of ghost vertices and cells
!   - create data structures for message passing
!   - create connectivity table for each subdomain
!
!   The algorithm for setting up the data structures is copied from decomp.F of
!   the ADCIRC suite
!
!   Modules used
!
      use ocpcomm4, only: itest, ltrace, printf
      use m_parall, only: iammaster, inode, nproc, swint
      use SwanGriddata, only: excmark, ivertg, kvertc, ncells, ncellsg, nverts, nvertsg, vmark
!
!   Parameter variables
!
      integer, parameter :: VERTICES_PER_CELL = 3 ! number of vertices in cell (triangles only)
!
!   Local variables
!
      integer :: i ! loop counter
      integer, dimension(2, NPROC) :: iarrc ! auxiliary array for collecting data
      integer, dimension(2) :: iarrl ! auxiliary array containing some data of each subdomain
      integer :: icell ! global cell index
      integer, save :: ient = 0 ! number of entries in this subroutine
      integer :: ip ! actual subdomain number
      integer :: istat ! indicate status of allocation
      integer :: ivert ! global vertex index
      integer :: j ! loop counter
      integer :: jvert ! local vertex index
      integer :: k ! (loop) counter
      integer, dimension(NPROC) :: ncellp ! Local cell counts, including ghosts.
      integer :: nl ! Number of entries to sort.
      integer, dimension(NPROC) :: nvresp ! Resident vertex counts.
      integer, dimension(NPROC) :: plistcm ! Neighbor partition numbers.
      integer, dimension(VERTICES_PER_CELL) :: cell_owners ! Owners of the three cell vertices.

      type :: partition_indices
         integer, dimension(:), allocatable :: values
      end type partition_indices

      type(partition_indices), dimension(:), allocatable :: cells_by_part, vertices_by_part
      integer, dimension(:), allocatable :: ivertl ! Local index of each global vertex.
      integer, dimension(:), allocatable :: jlist ! Scratch indices for sorting.
      integer, dimension(:, :), allocatable :: kvtcp ! Local cell connectivity.
      integer :: maxrvg, maxsvg ! Largest receive and send counts among neighbors.
      character(len=120) :: msgstr
!
!   Structure
!
!   Description of the pseudo code
!
!   Source text
!
      if (ltrace) then
         call strace(ient, 'SwanCommAdmin')
      end if
      !
      allocate (jlist(VERTICES_PER_CELL * ncellsg), ivertl(nvertsg), stat=istat)
      if (istat /= 0) then
         write (msgstr, '(a,i0)') 'Cannot allocate communication setup data, status ', istat
         call msgerr(4, trim(msgstr))
         return
      end if

      ! Every rank has the same global mesh and owner map. Reject an empty
      ! partition on all ranks before modifying the mesh or starting MPI.
      if (any(ipown < 1) .or. any(ipown > nproc)) then
         call msgerr(4, 'SwanCommAdmin: invalid vertex owner')
         return
      end if
      nvresp = 0
      do i = 1, nvertsg
         ip = ipown(i)
         nvresp(ip) = nvresp(ip) + 1
      end do

      ! A partition includes each cell incident on any of its resident
      ! vertices. Count each distinct owner once per cell.
      allocate (cells_by_part(nproc), vertices_by_part(nproc))
      ncellp = 0
      do icell = 1, ncellsg
         cell_owners = ipown(kvertc(:, icell))
         do k = 1, VERTICES_PER_CELL
            ip = cell_owners(k)
            if (.not. any(cell_owners(:k - 1) == ip)) then
               ncellp(ip) = ncellp(ip) + 1
            end if
         end do
      end do
      do ip = 1, nproc
         if (ncellp(ip) == 0) then
            write (msgstr, '(a,i0,a)') 'SwanCommAdmin: partition ', ip, ' has no cells'
            call msgerr(4, trim(msgstr))
            return
         end if
         allocate (cells_by_part(ip)%values(ncellp(ip)))
      end do

      ncellp = 0
      do icell = 1, ncellsg
         cell_owners = ipown(kvertc(:, icell))
         do k = 1, VERTICES_PER_CELL
            ip = cell_owners(k)
            if (.not. any(cell_owners(:k - 1) == ip)) then
               ncellp(ip) = ncellp(ip) + 1
               cells_by_part(ip)%values(ncellp(ip)) = icell
            end if
         end do
      end do

      ! Derive each partition's ordered vertex list from its cell list.
      do ip = 1, nproc
         nl = 0
         do j = 1, ncellp(ip)
            icell = cells_by_part(ip)%values(j)
            jlist(nl + 1:nl + VERTICES_PER_CELL) = kvertc(:, icell)
            nl = nl + VERTICES_PER_CELL
         end do
         call hpsort(jlist(:nl))
         k = 1
         do j = 2, nl
            if (jlist(j) /= jlist(k)) then
               k = k + 1
               jlist(k) = jlist(j)
            end if
         end do
         allocate (vertices_by_part(ip)%values(k), source=jlist(:k))
      end do

      ncells = ncellp(inode)
      nverts = size(vertices_by_part(inode)%values)
      allocate (ivertg(nverts), source=vertices_by_part(inode)%values)
      ivertl = 0
      do j = 1, nverts
         ivertl(ivertg(j)) = j
      end do
      !
      ! create identification list for vertices (resident/ghost)
      !
      allocate (vres(nverts))
      !
      do j = 1, nverts
         ivert = ivertg(j)
         ip = ipown(ivert)
         if (ip == INODE) then
            vres(j) = .true.
         else
            vres(j) = .false.
         end if
      end do
      !
      ! create vertex-based list of communicating subdomains
      !
      nvcomm = 0
      plistcm = 0
      !
      nl = 0
      do j = 1, nverts
         ivert = ivertg(j)
         ip = ipown(ivert)
         if (ip /= INODE) then
            nl = nl + 1
            jlist(nl) = ip
         end if
      end do
      if (nl == 0) then
         nvcomm = 0
      else
         ! sort and remove duplicates
         call hpsort(jlist(:nl))
         k = 1
         ip = jlist(1)
         plistcm(1) = ip
         do j = 2, nl
            if (jlist(j) /= ip) then
               k = k + 1
               ip = jlist(j)
               plistcm(k) = ip
            end if
         end do
         nvcomm = k
      end if
      !
      allocate (vsubcm(nvcomm))
      do j = 1, nvcomm
         vsubcm(j) = plistcm(j)
      end do
      !
      ! Size the send and receive maps, then fill them in global vertex
      ! order so both sides pack each halo message in the same order.
      allocate (nvrecv(nvcomm), nvsend(nvcomm), source=0)
      do j = 1, nvcomm
         ip = vsubcm(j)
         do jvert = 1, nverts
            if (ipown(ivertg(jvert)) == ip) then
               nvrecv(j) = nvrecv(j) + 1
            end if
         end do
         do k = 1, size(vertices_by_part(ip)%values)
            ivert = vertices_by_part(ip)%values(k)
            if (ipown(ivert) == inode) then
               nvsend(j) = nvsend(j) + 1
            end if
         end do
      end do
      maxrvg = max(0, maxval(nvrecv))
      maxsvg = max(0, maxval(nvsend))
      allocate (ivrecv(maxrvg, nvcomm), ivsend(maxsvg, nvcomm), source=0)
      do j = 1, nvcomm
         ip = vsubcm(j)
         i = 0
         do jvert = 1, nverts
            if (ipown(ivertg(jvert)) == ip) then
               i = i + 1
               ivrecv(i, j) = jvert
            end if
         end do
         i = 0
         do k = 1, size(vertices_by_part(ip)%values)
            ivert = vertices_by_part(ip)%values(k)
            if (ipown(ivert) == inode) then
               i = i + 1
               ivsend(i, j) = ivertl(ivert)
            end if
         end do
      end do

      allocate (kvtcp(VERTICES_PER_CELL, ncells), source=0)
      ! look for vertices for each local cell and put them in table
      do j = 1, ncells
         icell = cells_by_part(inode)%values(j)
         do k = 1, VERTICES_PER_CELL
            ivert = kvertc(k, icell)
            jvert = ivertl(ivert)
            if (jvert > 0) then
               kvtcp(k, j) = jvert
            else
               write (msgstr, '(a,i7,a,i7)') 'inconsistency found in SwanCommAdmin: global vertex ', ivert, &
                                           & ' missing in subdomain ', INODE
               call msgerr(4, trim(msgstr))
               return
            end if
         end do
      end do
      !
      ! delete other parts of connectivity table while keeping local table
      !
      call move_alloc(kvtcp, kvertc)
      !
      ! create copy of parts of vmark for each subdomain
      !
      ! use array ivertl to store vmark temporarily
      ivertl = vmark
      deallocate (vmark)
      allocate (vmark(nverts))
      !
      do jvert = 1, nverts
         ivert = ivertg(jvert)
         vmark(jvert) = ivertl(ivert)
         ! ghost vertices are marked with exception value
         if (.not. vres(jvert)) then
            vmark(jvert) = excmark
         end if
      end do
      !
      ! allocate arrays for MPI communication
      !
      allocate (rrqst(nvcomm))
      allocate (srqst(nvcomm))
      allocate (irbuf(maxrvg, nvcomm))
      allocate (isbuf(maxsvg, nvcomm))
      allocate (rbuf(maxrvg, nvcomm))
      allocate (sbuf(maxsvg, nvcomm))
      !
      deallocate (ivertl, jlist, cells_by_part, vertices_by_part)
      !
      iarrl(1) = nvcomm
      iarrl(2) = sum(nvrecv)
      call SWGATHER(iarrc, 2 * NPROC, iarrl, 2, SWINT)
      if (STPNOW()) then
         return
      end if
      !
      if (ITEST >= 50 .and. IAMMASTER) then
         write (PRINTF, '(a)')
         write (PRINTF, '(a)') ' communication data'
         write (PRINTF, '(a)') ' subdomain  # communicating PEs  comm. vol/calc. vol (%)'
         write (PRINTF, '(a)') ' ---------  -------------------  -----------------------'
         do i = 1, NPROC
            write (PRINTF, 201) i, iarrc(1, i), &
               (real(iarrc(2, i), kind=SWAN_REAL_KIND) / real(nvresp(i), kind=SWAN_REAL_KIND)) * 100.0_SWAN_REAL_KIND
         end do
         write (PRINTF, '(a)')
      end if
      !
201   format(1x, i9, 2x, i19, 2x, f8.2)
      !
   end subroutine SwanCommAdmin
!
   !> Update the ghost entries of an integer vertex field.
   !! Retain integer handles for the legacy MPI Fortran interface.
   subroutine SwanUvExchgI(ifld)
!
!   --|-----------------------------------------------------------|--
!     | Delft University of Technology                            |
!     | Faculty of Civil Engineering and Geosciences              |
!     | Environmental Fluid Mechanics Section                     |
!     | P.O. Box 5048, 2600 GA  Delft, The Netherlands            |
!     |                                                           |
!     | Programmer: Marcel Zijlema                                |
!   --|-----------------------------------------------------------|--
!
!
!     SWAN (Simulating WAves Nearshore); a third generation wave model
!     Copyright (C) 1993-2024  Delft University of Technology
!
!     This program is free software: you can redistribute it and/or modify
!     it under the terms of the GNU General Public License as published by
!     the Free Software Foundation, either version 3 of the License, or
!     (at your option) any later version.
!
!     This program is distributed in the hope that it will be useful,
!     but WITHOUT ANY WARRANTY; without even the implied warranty of
!     MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
!     GNU General Public License for more details.
!
!     You should have received a copy of the GNU General Public License
!     along with this program. If not, see <http://www.gnu.org/licenses/>.
!
!
!   Authors
!
!   42.10: Marcel Zijlema
!
!   Updates
!
!   42.10, June 2023: New subroutine
!
!   Purpose
!
!   Updates field array containing vertex entries of type integer through
!   exchanging values between neighbouring subdomains
!
!   Method
!
!   Make use of MPI non-blocking recv/send commands and also administration
!   (stored in ivsend/ivrecv)
!
!   Modules used
!
!MPI      use mpi, only: MPI_SUCCESS, MPI_STATUSES_IGNORE
      use ocpcomm4, only: ltrace
      use m_parall, only: inode, parll, swint
      use SwanGriddata, only: nverts
!
!   Argument variables
!
      integer, dimension(nverts), intent(inout) :: ifld !< Local vertex field, including ghosts.
!
!   Parameter variables
!
!
!   Local variables
!
      integer :: i ! loop counter
      integer :: idom ! subdomain number
      integer, save :: ient = 0 ! number of entries in this subroutine
      integer :: ierr ! error value of MPI call
      integer :: j ! loop counter
      integer :: ndata ! number of variables to send/receive
      character(len=120) :: msgstr ! string to pass message
!
!   Structure
!
!   Description of the pseudo code
!
!   Source text
!
      if (ltrace) then
         call strace(ient, 'SwanUvExchgI')
      end if
      !
      if (.not. PARLL) then
         return
      end if
!NMPI      call msgerr(4, 'SwanUvExchgI requires an MPI-enabled SWAN build')
!NMPI      return
!MPI      !
!MPI      ! store data to be sent
!MPI      !
!MPI      do j = 1, nvcomm
!MPI         do i = 1, nvsend(j)
!MPI            isbuf(i, j) = ifld(ivsend(i, j))
!MPI         end do
!MPI      end do
!MPI      !
!MPI      ! for all neighbouring subdomains do
!MPI      !
!MPI      do j = 1, nvcomm
!MPI         !
!MPI         ! get subdomain number and number of ghost values to receive
!MPI         !
!MPI         idom = vsubcm(j)
!MPI         ndata = nvrecv(j)
!MPI         !
!MPI         ! post recvs
!MPI         !
!MPI         call MPI_IRECV ( irbuf(1,j), ndata, SWINT, idom-1, HALO_TAG, SwanParallelComm(), rrqst(j), ierr )
!MPI         if ( ierr /= MPI_SUCCESS ) then
!MPI            write (msgstr, '(a,i0,a,i0)') 'MPI status ', ierr, ' on SWAN rank ', inode
!MPI            call msgerr ( 4, trim(msgstr) )
!MPI            return
!MPI         end if
!MPI         !
!MPI         ! get number of ghost values to send
!MPI         !
!MPI         ndata = nvsend(j)
!MPI         !
!MPI         ! post sends
!MPI         !
!MPI         call MPI_ISEND ( isbuf(1,j), ndata, SWINT, idom-1, HALO_TAG, SwanParallelComm(), srqst(j), ierr )
!MPI         if ( ierr /= MPI_SUCCESS ) then
!MPI            write (msgstr, '(a,i0,a,i0)') 'MPI status ', ierr, ' on SWAN rank ', inode
!MPI            call msgerr ( 4, trim(msgstr) )
!MPI            return
!MPI         end if
!MPI         !
!MPI      end do
!MPI      !
!MPI      ! wait for receives to complete
!MPI      !
!MPI      call MPI_WAITALL ( nvcomm, rrqst, MPI_STATUSES_IGNORE, ierr )
!MPI      if ( ierr /= MPI_SUCCESS ) then
!MPI         write (msgstr, '(a,i0,a,i0)') 'MPI status ', ierr, ' on SWAN rank ', inode
!MPI         call msgerr ( 4, trim(msgstr) )
!MPI         return
!MPI      end if
!MPI      !
!MPI      ! store the received data
!MPI      !
!MPI      do j = 1, nvcomm
!MPI         do i = 1, nvrecv(j)
!MPI            ifld(ivrecv(i, j)) = irbuf(i, j)
!MPI         end do
!MPI      end do
!MPI      !
!MPI      ! wait for sends to complete
!MPI      !
!MPI      call MPI_WAITALL ( nvcomm, srqst, MPI_STATUSES_IGNORE, ierr)
!MPI      if ( ierr /= MPI_SUCCESS ) then
!MPI         write (msgstr, '(a,i0,a,i0)') 'MPI status ', ierr, ' on SWAN rank ', inode
!MPI         call msgerr ( 4, trim(msgstr) )
!MPI         return
!MPI      end if
      !
   end subroutine SwanUvExchgI
!
   !> Update the ghost entries of a real vertex field.
   !! Retain integer handles for the legacy MPI Fortran interface.
   subroutine SwanUvExchgR(fld)
!
!   --|-----------------------------------------------------------|--
!     | Delft University of Technology                            |
!     | Faculty of Civil Engineering and Geosciences              |
!     | Environmental Fluid Mechanics Section                     |
!     | P.O. Box 5048, 2600 GA  Delft, The Netherlands            |
!     |                                                           |
!     | Programmer: Marcel Zijlema                                |
!   --|-----------------------------------------------------------|--
!
!
!     SWAN (Simulating WAves Nearshore); a third generation wave model
!     Copyright (C) 1993-2024  Delft University of Technology
!
!     This program is free software: you can redistribute it and/or modify
!     it under the terms of the GNU General Public License as published by
!     the Free Software Foundation, either version 3 of the License, or
!     (at your option) any later version.
!
!     This program is distributed in the hope that it will be useful,
!     but WITHOUT ANY WARRANTY; without even the implied warranty of
!     MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
!     GNU General Public License for more details.
!
!     You should have received a copy of the GNU General Public License
!     along with this program. If not, see <http://www.gnu.org/licenses/>.
!
!
!   Authors
!
!   42.10: Marcel Zijlema
!
!   Updates
!
!   42.10, June 2023: New subroutine
!
!   Purpose
!
!   Updates field array containing vertex entries of type real through
!   exchanging values between neighbouring subdomains
!
!   Method
!
!   Make use of MPI non-blocking recv/send commands and also administration
!   (stored in ivsend/ivrecv)
!
!   Modules used
!
!MPI      use mpi, only: MPI_SUCCESS, MPI_STATUSES_IGNORE
      use ocpcomm4, only: ltrace
      use m_parall, only: inode, parll, swreal
      use SwanGriddata, only: nverts
!
!   Argument variables
!
      real(kind=SWAN_REAL_KIND), dimension(nverts), intent(inout) :: fld !< Local vertex field, including ghosts.
!
!   Parameter variables
!
!
!   Local variables
!
      integer :: i ! loop counter
      integer :: idom ! subdomain number
      integer, save :: ient = 0 ! number of entries in this subroutine
      integer :: ierr ! error value of MPI call
      integer :: j ! loop counter
      integer :: ndata ! number of variables to send/receive
      character(len=120) :: msgstr ! string to pass message
!
!   Structure
!
!   Description of the pseudo code
!
!   Source text
!
      if (ltrace) then
         call strace(ient, 'SwanUvExchgR')
      end if
      !
      if (.not. PARLL) then
         return
      end if
!NMPI      call msgerr(4, 'SwanUvExchgR requires an MPI-enabled SWAN build')
!NMPI      return
!MPI      !
!MPI      ! store data to be sent
!MPI      !
!MPI      do j = 1, nvcomm
!MPI         do i = 1, nvsend(j)
!MPI            sbuf(i, j) = fld(ivsend(i, j))
!MPI         end do
!MPI      end do
!MPI      !
!MPI      ! for all neighbouring subdomains do
!MPI      !
!MPI      do j = 1, nvcomm
!MPI         !
!MPI         ! get subdomain number and number of ghost values to receive
!MPI         !
!MPI         idom = vsubcm(j)
!MPI         ndata = nvrecv(j)
!MPI         !
!MPI         ! post recvs
!MPI         !
!MPI         call MPI_IRECV ( rbuf(1,j), ndata, SWREAL, idom-1, HALO_TAG, SwanParallelComm(), rrqst(j), ierr )
!MPI         if ( ierr /= MPI_SUCCESS ) then
!MPI            write (msgstr, '(a,i0,a,i0)') 'MPI status ', ierr, ' on SWAN rank ', inode
!MPI            call msgerr ( 4, trim(msgstr) )
!MPI            return
!MPI         end if
!MPI         !
!MPI         ! get number of ghost values to send
!MPI         !
!MPI         ndata = nvsend(j)
!MPI         !
!MPI         ! post sends
!MPI         !
!MPI         call MPI_ISEND ( sbuf(1,j), ndata, SWREAL, idom-1, HALO_TAG, SwanParallelComm(), srqst(j), ierr )
!MPI         if ( ierr /= MPI_SUCCESS ) then
!MPI            write (msgstr, '(a,i0,a,i0)') 'MPI status ', ierr, ' on SWAN rank ', inode
!MPI            call msgerr ( 4, trim(msgstr) )
!MPI            return
!MPI         end if
!MPI         !
!MPI      end do
!MPI      !
!MPI      ! wait for receives to complete
!MPI      !
!MPI      call MPI_WAITALL ( nvcomm, rrqst, MPI_STATUSES_IGNORE, ierr )
!MPI      if ( ierr /= MPI_SUCCESS ) then
!MPI         write (msgstr, '(a,i0,a,i0)') 'MPI status ', ierr, ' on SWAN rank ', inode
!MPI         call msgerr ( 4, trim(msgstr) )
!MPI         return
!MPI      end if
!MPI      !
!MPI      ! store the received data
!MPI      !
!MPI      do j = 1, nvcomm
!MPI         do i = 1, nvrecv(j)
!MPI            fld(ivrecv(i, j)) = rbuf(i, j)
!MPI         end do
!MPI      end do
!MPI      !
!MPI      ! wait for sends to complete
!MPI      !
!MPI      call MPI_WAITALL ( nvcomm, srqst, MPI_STATUSES_IGNORE, ierr)
!MPI      if ( ierr /= MPI_SUCCESS ) then
!MPI         write (msgstr, '(a,i0,a,i0)') 'MPI status ', ierr, ' on SWAN rank ', inode
!MPI         call msgerr ( 4, trim(msgstr) )
!MPI         return
!MPI      end if
      !
   end subroutine SwanUvExchgR
!
   !> Gather global boundary polygons from the local partitions.
   subroutine SwanCollBpntlist
!
!   --|-----------------------------------------------------------|--
!     | Delft University of Technology                            |
!     | Faculty of Civil Engineering and Geosciences              |
!     | Environmental Fluid Mechanics Section                     |
!     | P.O. Box 5048, 2600 GA  Delft, The Netherlands            |
!     |                                                           |
!     | Programmer: Marcel Zijlema                                |
!   --|-----------------------------------------------------------|--
!
!
!     SWAN (Simulating WAves Nearshore); a third generation wave model
!     Copyright (C) 1993-2024  Delft University of Technology
!
!     This program is free software: you can redistribute it and/or modify
!     it under the terms of the GNU General Public License as published by
!     the Free Software Foundation, either version 3 of the License, or
!     (at your option) any later version.
!
!     This program is distributed in the hope that it will be useful,
!     but WITHOUT ANY WARRANTY; without even the implied warranty of
!     MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
!     GNU General Public License for more details.
!
!     You should have received a copy of the GNU General Public License
!     along with this program. If not, see <http://www.gnu.org/licenses/>.
!
!
!   Authors
!
!   43.01: Marcel Zijlema
!
!   Updates
!
!   43.01, August 2024: New subroutine
!
!   Purpose
!
!   Gathers the lists of boundary points in the ascending order from each
!   processor to all the processes
!
!   Modules used
!
!MPI      use mpi, only: MPI_SUCCESS
      use ocpcomm4, only: ltrace
      use m_parall, only: inode, nproc, parll, swint, swsum
      use SwanGriddata, only: excmark, ivertg, vmark, xcugrdgl, ycugrdgl
      use SwanCompdata, only: blist, bmark, nbpol, nbpt
!
!   Local variables
!
      integer, dimension(:), allocatable :: blistg ! list of unordered boundary vertices in global grid
      integer, dimension(:), allocatable :: bmarkg ! list of corresponding boundary markers in global grid
      integer :: i ! loop counter
      integer, dimension(:), allocatable :: iarr1 ! temporary array to store genuine global boundary indices
      integer, dimension(:), allocatable :: iarr2 ! temporary array to store corresponding boundary markers
      integer, dimension(:), allocatable :: iarr3 ! temporary array to store corresponding sequence number of boundary polygons
      integer, dimension(:), allocatable :: iarrg1 ! same as iarr1 but global
      integer, dimension(:), allocatable :: iarrg2 ! same as iarr2 but global
      integer, dimension(:), allocatable :: iarrg3 ! same as iarr3 but global
      integer, dimension(:), allocatable :: icount ! array specifying array size of data received from each processor
      integer, dimension(:), allocatable :: idsplc ! array specifying the starting address of the incoming data from
      ! each processor, relative to the global array
      integer, save :: ient = 0 ! number of entries in this subroutine
      integer                              :: ierr     ! error value of MPI call
      integer :: ii ! help index
      integer :: istat ! indicate status of allocation
      integer :: itmp ! temporary stored integer for swapping
      integer :: j ! loop counter
      integer, dimension(:), allocatable :: jlist ! list of ascending order of boundary indices
      integer :: k ! counter
      integer, dimension(1) :: kd ! location of minimum value in array ang
      integer :: maxnbp ! maximum number of boundary vertices in set of polygons
      integer :: nbp ! number of boundary vertices in present boundary polygon
      integer :: nbptot ! total number of boundary vertices
      integer :: nbpgl ! number of boundary vertices in global grid
      integer :: nbpolgl ! number of boundary polygons in global grid
      !
      real(kind=SWAN_REAL_KIND), dimension(:), allocatable :: ang ! angle of boundary points with respect to centroid
      real(kind=SWAN_REAL_KIND), dimension(:), allocatable :: dxc ! distance in x-direction with respect to centroid
      real(kind=SWAN_REAL_KIND), dimension(:), allocatable :: dyc ! distance in y-direction with respect to centroid
      real(kind=SWAN_REAL_KIND) :: rtmp ! temporary stored real for swapping
      real(kind=SWAN_REAL_KIND) :: sumx ! sum of all x-coordinates of boundary points
      real(kind=SWAN_REAL_KIND) :: sumy ! sum of all y-coordinates of boundary points
      real(kind=SWAN_REAL_KIND) :: xc ! x-coordinate of centroid
      real(kind=SWAN_REAL_KIND) :: yc ! y-coordinate of centroid
      !
      character(len=120)                       :: msgstr   ! string to pass message
!
!   Structure
!
!   Description of the pseudo code
!
!   for each boundary polygon do
!       complete the list of genuine boundary points and scatter to all
!       processes
!       re-order this list counterclockwise
!
      if (ltrace) then
         call strace(ient, 'SwanCollBpntlist')
      end if
      !
      ! if not parallel, return
      !
      if (.not. PARLL) then
         return
      end if
!NMPI      call msgerr(4, 'SwanCollBpntlist requires an MPI-enabled SWAN build')
!NMPI      return
!MPI      !
!MPI      allocate (icount(0:NPROC - 1))
!MPI      allocate (idsplc(0:NPROC - 1))
!MPI      !
!MPI      maxnbp = size(blist) / nbpol
!MPI      !
!MPI      nbptot = maxnbp * nbpol
!MPI      !
!MPI      ! store the global indices, markers and polygon sequence number of
!MPI      ! genuine boundary points
!MPI      !
!MPI      allocate (iarr1(nbptot))
!MPI      allocate (iarr2(nbptot))
!MPI      allocate (iarr3(nbptot))
!MPI      !
!MPI      k = 0
!MPI      !
!MPI      do j = 1, nbpol
!MPI         !
!MPI         do i = 1, maxnbp
!MPI            !
!MPI            ii = blist(i, j)
!MPI            !
!MPI            if (ii > 0) then
!MPI               if (vmark(ii) < excmark) then
!MPI                  k = k + 1
!MPI                  iarr1(k) = ivertg(ii)
!MPI                  iarr2(k) = vmark(ii)
!MPI                  iarr3(k) = j
!MPI                  !
!MPI               end if
!MPI            end if
!MPI            !
!MPI         end do
!MPI         !
!MPI      end do
!MPI      !
!MPI      deallocate (blist)
!MPI      !
!MPI      nbptot = k
!MPI      !
!MPI      ! calculate the global size as sum of the local sizes
!MPI      !
!MPI      call MPI_ALLREDUCE ( nbptot, nbpgl, 1, SWINT, SWSUM, SwanParallelComm(), ierr )
!MPI      if ( ierr /= MPI_SUCCESS ) then
!MPI         write (msgstr, '(a,i0,a,i0)') 'MPI status ', ierr, ' on SWAN rank ', inode
!MPI         call msgerr ( 4, trim(msgstr) )
!MPI         return
!MPI      end if
!MPI      !
!MPI      ! allocate temporary global data
!MPI      !
!MPI      istat = 0
!MPI      if (.not. allocated(iarrg1)) then
!MPI         allocate (iarrg1(nbpgl), stat=istat)
!MPI      end if
!MPI      if (istat == 0 .and. .not. allocated(iarrg2)) then
!MPI         allocate (iarrg2(nbpgl), stat=istat)
!MPI      end if
!MPI      if (istat == 0 .and. .not. allocated(iarrg3)) then
!MPI         allocate (iarrg3(nbpgl), stat=istat)
!MPI      end if
!MPI      if (istat /= 0) then
!MPI         call msgerr(4, 'Allocation problem in SwanCollBpntlist: temporary global data ')
!MPI         return
!MPI      end if
!MPI      !
!MPI      ! gather the array sizes to all the processes
!MPI      !
!MPI      call MPI_ALLGATHER ( nbptot, 1, SWINT, icount, 1, SWINT, SwanParallelComm(), ierr )
!MPI      if ( ierr /= MPI_SUCCESS ) then
!MPI         write (msgstr, '(a,i0,a,i0)') 'MPI status ', ierr, ' on SWAN rank ', inode
!MPI         call msgerr ( 4, trim(msgstr) )
!MPI         return
!MPI      end if
!MPI      !
!MPI      ! calculate starting address of each local array with respect to the
!MPI      ! global array
!MPI      !
!MPI      idsplc(0) = 0
!MPI      do i = 1, NPROC - 1
!MPI         idsplc(i) = icount(i - 1) + idsplc(i - 1)
!MPI      end do
!MPI      !
!MPI      ! gather blist from each processor to all the processes
!MPI      !
!MPI      call MPI_ALLGATHERV ( iarr1(1:nbptot), nbptot, SWINT, iarrg1, icount, idsplc, SWINT, SwanParallelComm(), ierr )
!MPI      if ( ierr /= MPI_SUCCESS ) then
!MPI         write (msgstr, '(a,i0,a,i0)') 'MPI status ', ierr, ' on SWAN rank ', inode
!MPI         call msgerr ( 4, trim(msgstr) )
!MPI         return
!MPI      end if
!MPI      !
!MPI      ! gather corresponding markers from each processor to all the
!MPI      ! processes
!MPI      !
!MPI      call MPI_ALLGATHERV ( iarr2(1:nbptot), nbptot, SWINT, iarrg2, icount, idsplc, SWINT, SwanParallelComm(), ierr )
!MPI      if ( ierr /= MPI_SUCCESS ) then
!MPI         write (msgstr, '(a,i0,a,i0)') 'MPI status ', ierr, ' on SWAN rank ', inode
!MPI         call msgerr ( 4, trim(msgstr) )
!MPI         return
!MPI      end if
!MPI      !
!MPI      ! gather corresponding polygon sequence number from each processor to
!MPI      ! all the processes
!MPI      !
!MPI      call MPI_ALLGATHERV ( iarr3(1:nbptot), nbptot, SWINT, iarrg3, icount, idsplc, SWINT, SwanParallelComm(), ierr )
!MPI      if ( ierr /= MPI_SUCCESS ) then
!MPI         write (msgstr, '(a,i0,a,i0)') 'MPI status ', ierr, ' on SWAN rank ', inode
!MPI         call msgerr ( 4, trim(msgstr) )
!MPI         return
!MPI      end if
!MPI      !
!MPI      deallocate (iarr1, iarr2, iarr3, icount, idsplc)
!MPI      !
!MPI      if (nbpgl <= 0) then
!MPI         call msgerr(4, 'SwanCollBpntlist: no genuine boundary points found ')
!MPI         return
!MPI      end if
!MPI      !
!MPI      nbpt = 0
!MPI      !
!MPI      ! determine maximum number of boundary polygons in global grid
!MPI      !
!MPI      nbpolgl = maxval(iarrg3)
!MPI      !
!MPI      ! determine maximum number of boundary vertices in set of polygons
!MPI      !
!MPI      maxnbp = -999
!MPI      !
!MPI      do j = 1, nbpolgl
!MPI         nbp = count(mask=iarrg3 == j)
!MPI         if (nbp > maxnbp) then
!MPI            maxnbp = nbp
!MPI         end if
!MPI      end do
!MPI      !
!MPI      ! allocate and initialize blist and bmark
!MPI      !
!MPI      istat = 0
!MPI      if (.not. allocated(blist)) then
!MPI         allocate (blist(maxnbp, nbpolgl), stat=istat)
!MPI      end if
!MPI      if (istat == 0 .and. .not. allocated(bmark)) then
!MPI         allocate (bmark(maxnbp, nbpolgl), stat=istat)
!MPI      end if
!MPI      if (istat /= 0) then
!MPI         call msgerr(4, 'Allocation problem in SwanCollBpntlist: array blist and bmark ')
!MPI         return
!MPI      end if
!MPI      !
!MPI      blist = 0
!MPI      bmark = 0
!MPI      !
!MPI      ! allocate global data to store unordered boundary indices and
!MPI      ! corresponding markers
!MPI      !
!MPI      istat = 0
!MPI      if (.not. allocated(blistg)) then
!MPI         allocate (blistg(nbpgl), stat=istat)
!MPI      end if
!MPI      if (istat == 0 .and. .not. allocated(bmarkg)) then
!MPI         allocate (bmarkg(nbpgl), stat=istat)
!MPI      end if
!MPI      if (istat /= 0) then
!MPI         call msgerr(4, 'Allocation problem in SwanCollBpntlist: array blistg and bmarkg ')
!MPI         return
!MPI      end if
!MPI      !
!MPI      blistg = 0
!MPI      bmarkg = 0
!MPI      !
!MPI      ! complete the list of genuine boundary vertices in ascending order
!MPI      ! for all boundary polygons
!MPI      !
!MPI      nbpol = 0
!MPI      !
!MPI      do j = 1, nbpolgl
!MPI         !
!MPI         k = 0
!MPI         !
!MPI         do i = 1, nbpgl
!MPI            !
!MPI            if (iarrg3(i) == j) then
!MPI               !
!MPI               k = k + 1
!MPI               !
!MPI               blistg(k) = iarrg1(i)
!MPI               bmarkg(k) = iarrg2(i)
!MPI               !
!MPI            end if
!MPI            !
!MPI         end do
!MPI         !
!MPI         nbp = k
!MPI         !
!MPI         if (nbp == 0) then
!MPI            cycle
!MPI         end if
!MPI         !
!MPI         nbpol = nbpol + 1
!MPI         !
!MPI         ! allocate data for computing the order of boundary points
!MPI         !
!MPI         istat = 0
!MPI         if (.not. allocated(ang)) then
!MPI            allocate (ang(nbp), stat=istat)
!MPI         end if
!MPI         if (istat == 0 .and. .not. allocated(dxc)) then
!MPI            allocate (dxc(nbp), stat=istat)
!MPI         end if
!MPI         if (istat == 0 .and. .not. allocated(dyc)) then
!MPI            allocate (dyc(nbp), stat=istat)
!MPI         end if
!MPI         if (istat == 0 .and. .not. allocated(jlist)) then
!MPI            allocate (jlist(nbp), stat=istat)
!MPI         end if
!MPI         if (istat /= 0) then
!MPI            call msgerr(4, 'Allocation problem in SwanCollBpntlist: array ang, dxc, dyc and jlist ')
!MPI            return
!MPI         end if
!MPI         !
!MPI         ! first determine centroid
!MPI         !
!MPI         sumx = 0.0_SWAN_REAL_KIND
!MPI         sumy = 0.0_SWAN_REAL_KIND
!MPI         do i = 1, nbp
!MPI            ii = blistg(i)
!MPI            sumx = sumx + xcugrdgl(ii)
!MPI            sumy = sumy + ycugrdgl(ii)
!MPI         end do
!MPI         !
!MPI         xc = sumx / real(nbp, kind=SWAN_REAL_KIND)
!MPI         yc = sumy / real(nbp, kind=SWAN_REAL_KIND)
!MPI         !
!MPI         do i = 1, nbp
!MPI            ii = blistg(i)
!MPI            dxc(i) = xcugrdgl(ii) - xc
!MPI            dyc(i) = ycugrdgl(ii) - yc
!MPI         end do
!MPI         !
!MPI         ! determine angle of each boundary point with respect to centroid
!MPI         !
!MPI         ang(1:nbp) = atan2(dyc(1:nbp), dxc(1:nbp))
!MPI         !
!MPI         ! sort angles counterclockwise
!MPI         !
!MPI         do i = 1, nbp
!MPI            jlist(i) = i
!MPI         end do
!MPI         !
!MPI         do i = 1, nbp - 1
!MPI            !
!MPI            kd = minloc(ang(i:nbp))
!MPI            k = kd(1) + i - 1
!MPI            !
!MPI            if (k /= i) then
!MPI               !
!MPI               rtmp = ang(i)
!MPI               ang(i) = ang(k)
!MPI               ang(k) = rtmp
!MPI               !
!MPI               itmp = jlist(i)
!MPI               jlist(i) = jlist(k)
!MPI               jlist(k) = itmp
!MPI               !
!MPI            end if
!MPI            !
!MPI         end do
!MPI         !
!MPI         ! sort blist and corresponding markers accordingly
!MPI         !
!MPI         do i = 1, nbp
!MPI            blist(i, nbpol) = blistg(jlist(i))
!MPI            bmark(i, nbpol) = bmarkg(jlist(i))
!MPI         end do
!MPI         !
!MPI         ! store number of boundary vertices for present polygon
!MPI         !
!MPI         nbpt(nbpol) = nbp
!MPI         !
!MPI         deallocate (ang, dxc, dyc, jlist)
!MPI         !
!MPI      end do
!MPI      !
!MPI      deallocate (iarrg1, iarrg2, iarrg3, blistg, bmarkg)
      !
   end subroutine SwanCollBpntlist
!
   !> Sort a vertex or partition index list in ascending order.
   subroutine hpsort(indices)
      integer(kind=METIS_INDEX_KIND), dimension(:), intent(inout) :: indices !< Index list.

      integer :: heap_start, heap_end, parent, child
      integer(kind=METIS_INDEX_KIND) :: value

      heap_end = size(indices)
      if (heap_end < 2) then
         return
      end if

      heap_start = heap_end / 2 + 1
      ! Build a max heap from the right, then move its largest value to
      ! the end of the unsorted prefix and restore the heap.
      do
         if (heap_start > 1) then
            heap_start = heap_start - 1
            value = indices(heap_start)
         else
            value = indices(heap_end)
            indices(heap_end) = indices(1)
            heap_end = heap_end - 1
            if (heap_end == 1) then
               indices(1) = value
               exit
            end if
         end if

         parent = heap_start
         do
            if (parent > heap_end / 2) then
               exit
            end if
            child = 2 * parent
            if (child < heap_end) then
               if (indices(child) < indices(child + 1)) then
                  child = child + 1
               end if
            end if
            if (value >= indices(child)) then
               exit
            end if
            indices(parent) = indices(child)
            parent = child
         end do
         indices(parent) = value
      end do
   end subroutine hpsort

end module SwanParallel
